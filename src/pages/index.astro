---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Video from '../components/Video.astro';
import Marketing from '../components/Marketing.astro';
import Influencer from '../components/Influencer.astro';
import Reviews from '../components/Reviews.astro';
import Brands from '../components/Brands.astro';
import Contact from '../components/Contact.astro';
import { photography, video, marketing, influencer } from '../data/site';
---
<Layout>
  <Hero />
  <About />
  <Gallery />
  <CtaBand line={photography.cta.line} label={photography.cta.label} />
  <Video />
  <CtaBand line={video.cta.line} label={video.cta.label} />
  <Marketing />
  <CtaBand line={marketing.cta.line} label={marketing.cta.label} />
  <Influencer />
  <CtaBand line={influencer.cta.line} label={influencer.cta.label} />
  <Reviews />
  <Brands />
  <Contact />
</Layout>
