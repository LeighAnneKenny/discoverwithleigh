---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Video from '../components/Video.astro';
import Marketing from '../components/Marketing.astro';
import Influencer from '../components/Influencer.astro';
import Reviews from '../components/Reviews.astro';
import Brands from '../components/Brands.astro';
import Contact from '../components/Contact.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { loadContent, loadGallery, loadBrands } from '../lib/content';

export const prerender = false;

const [c, gallery, brands] = await Promise.all([loadContent(), loadGallery(), loadBrands()]);

// Structured data for search engines and LLM crawlers
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Discover With Leigh',
  description: c.meta.description,
  url: c.meta.url,
  telephone: c.contact.phone,
  email: c.contact.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Century City, Cape Town', addressCountry: 'ZA' },
  areaServed: 'Cape Town, South Africa',
  knowsAbout: [...c.services],
  sameAs: c.socials.filter((s) => s.show).map((s) => s.url),
};
---
<Layout title={c.meta.title} description={c.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero hero={c.hero} />
  <About about={c.about} services={c.services} />
  <Gallery photography={c.photography} items={gallery} />
  <CtaBand line={c.photography.cta.line} label={c.photography.cta.label} />
  <Video video={c.video} />
  <CtaBand line={c.video.cta.line} label={c.video.cta.label} />
  <Marketing marketing={c.marketing} />
  <CtaBand line={c.marketing.cta.line} label={c.marketing.cta.label} />
  <Influencer influencer={c.influencer} />
  <CtaBand line={c.influencer.cta.line} label={c.influencer.cta.label} />
  <Reviews reviews={c.reviews} />
  <Brands items={brands} />
  <Contact contact={c.contact} socials={c.socials} />
  <WhatsAppFab contact={c.contact} />
</Layout>
