---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/nunito-sans';
import '../../styles/global.css';
import Aperture from '../../components/Aperture.astro';

export const prerender = false;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin | Discover With Leigh</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <header class="bar">
      <span class="brand"><Aperture class="mark" /> Discover <em>with</em> Leigh — Admin</span>
      <nav class="tabs" id="tabs">
        <button data-tab="content" class="is-active">Content</button>
        <button data-tab="gallery">Gallery</button>
        <button data-tab="brands">Brands</button>
        <button data-tab="enquiries">Enquiries</button>
      </nav>
    </header>

    <main class="panel">
      <p id="status" class="status" role="status" hidden></p>
      <section id="tab-content"></section>
      <section id="tab-gallery" hidden>
        <label class="upload">Add photos <input type="file" id="gallery-files" accept="image/*" multiple /></label>
        <div class="grid" id="gallery-grid"></div>
      </section>
      <section id="tab-brands" hidden>
        <label class="upload">Add logos <input type="file" id="brands-files" accept="image/*" multiple /></label>
        <div class="grid grid-small" id="brands-grid"></div>
      </section>
      <section id="tab-enquiries" hidden></section>
    </main>

    <script>
      const $ = (s: string) => document.querySelector(s) as HTMLElement;
      const statusEl = $('#status');
      let statusTimer: ReturnType<typeof setTimeout>;
      function flash(msg: string, isError = false) {
        statusEl.textContent = msg;
        statusEl.classList.toggle('is-error', isError);
        statusEl.hidden = false;
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => (statusEl.hidden = true), 3500);
      }
      async function api(path: string, init?: RequestInit) {
        const res = await fetch(path, init);
        if (!res.ok) {
          flash(`Request failed (${res.status})`, true);
          throw new Error(String(res.status));
        }
        return res.json();
      }

      // ---- tabs ----
      document.querySelectorAll<HTMLButtonElement>('#tabs button').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelectorAll('#tabs button').forEach((x) => x.classList.toggle('is-active', x === b));
          for (const name of ['content', 'gallery', 'brands', 'enquiries']) {
            $(`#tab-${name}`).hidden = name !== b.dataset.tab;
          }
        }),
      );

      // ---- content: recursive form over section JSON ----
      const LABELS: Record<string, string> = {
        meta: 'Site metadata', hero: 'Hero', about: 'About', services: 'Services list',
        photography: 'Photography', video: 'Video', marketing: 'Social media management',
        influencer: 'Influencer', reviews: 'Client reviews', contact: 'Contact details',
        socials: 'Social links', qa: 'Q&A (chips widget)',
      };
      const content: Record<string, any> = await api('/api/admin/content');

      function get(obj: any, path: (string | number)[]) {
        return path.reduce((o, k) => o[k], obj);
      }
      function set(obj: any, path: (string | number)[], v: any) {
        get(obj, path.slice(0, -1))[path.at(-1)!] = v;
      }

      // Blanked deep-clone of an existing item, used as the template for "+ Add".
      function blank(v: any): any {
        if (typeof v === 'string') return '';
        if (typeof v === 'boolean') return true;
        if (Array.isArray(v)) return [];
        if (v && typeof v === 'object') return Object.fromEntries(Object.keys(v).map((k) => [k, blank(v[k])]));
        return v;
      }
      // Item shape per list, captured before the list can be emptied.
      const templates: Record<string, any> = {};

      function chip(label: string, fn: () => void, cls = 'chip') {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.className = cls;
        b.addEventListener('click', fn);
        return b;
      }

      // Editable list: every array gets move/remove per item and an Add button.
      function renderList(root: string, arrPath: (string | number)[], into: HTMLElement) {
        const arr: any[] = arrPath.length ? get(content[root], arrPath) : content[root];
        const tplKey = [root, ...arrPath].join('.');
        if (!(tplKey in templates) && arr.length) templates[tplKey] = blank(arr[0]);
        const redraw = () => renderList(root, arrPath, into);
        into.replaceChildren();
        arr.forEach((item, i) => {
          const row = document.createElement('div');
          row.className = 'list-item';
          row.appendChild(field(root, [...arrPath, i], item));
          const ctl = document.createElement('div');
          ctl.className = 'item-ctl';
          ctl.append(
            chip('↑', () => { if (i > 0) { [arr[i - 1], arr[i]] = [arr[i], arr[i - 1]]; redraw(); } }),
            chip('↓', () => { if (i < arr.length - 1) { [arr[i + 1], arr[i]] = [arr[i], arr[i + 1]]; redraw(); } }),
            chip('✕', () => { arr.splice(i, 1); redraw(); }, 'chip danger'),
          );
          row.appendChild(ctl);
          into.appendChild(row);
        });
        into.appendChild(chip('+ Add', () => { arr.push(structuredClone(templates[tplKey] ?? '')); redraw(); }));
      }

      function field(root: string, path: (string | number)[], value: any): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = 'field';
        const name = String(path.at(-1));

        if (typeof value === 'string') {
          const label = document.createElement('label');
          label.textContent = /^\d+$/.test(name) ? `#${Number(name) + 1}` : name;
          const input = value.length > 70 ? document.createElement('textarea') : document.createElement('input');
          if (input instanceof HTMLTextAreaElement) input.rows = Math.min(8, Math.ceil(value.length / 90) + 1);
          input.value = value;
          input.addEventListener('input', () => set(content[root], path, input.value));
          label.appendChild(input);
          wrap.appendChild(label);
        } else if (typeof value === 'boolean') {
          const label = document.createElement('label');
          label.className = 'check';
          const input = document.createElement('input');
          input.type = 'checkbox';
          input.checked = value;
          input.addEventListener('change', () => set(content[root], path, input.checked));
          label.append(input, name);
          wrap.appendChild(label);
        } else if (Array.isArray(value)) {
          const fs = document.createElement('fieldset');
          const lg = document.createElement('legend');
          lg.textContent = name;
          fs.appendChild(lg);
          const list = document.createElement('div');
          renderList(root, path, list);
          fs.appendChild(list);
          wrap.appendChild(fs);
        } else if (value && typeof value === 'object') {
          const fs = document.createElement('fieldset');
          if (!/^\d+$/.test(name)) {
            const lg = document.createElement('legend');
            lg.textContent = name;
            fs.appendChild(lg);
          }
          for (const k of Object.keys(value)) fs.appendChild(field(root, [...path, k], value[k]));
          wrap.appendChild(fs);
        }
        return wrap;
      }

      const contentTab = $('#tab-content');
      for (const key of Object.keys(LABELS)) {
        if (!(key in content)) continue;
        const det = document.createElement('details');
        det.innerHTML = `<summary>${LABELS[key]}</summary>`;
        const body = document.createElement('div');
        const v = content[key];
        if (Array.isArray(v)) {
          const list = document.createElement('div');
          renderList(key, [], list);
          body.appendChild(list);
        } else {
          for (const k of Object.keys(v)) body.appendChild(field(key, [k], v[k]));
        }
        const save = document.createElement('button');
        save.className = 'btn-save';
        save.textContent = 'Save';
        save.addEventListener('click', async () => {
          await api('/api/admin/content', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key, value: content[key] }),
          });
          flash(`${LABELS[key]} saved — live immediately.`);
        });
        body.appendChild(save);
        det.appendChild(body);
        contentTab.appendChild(det);
      }

      // ---- media (gallery + brands) ----
      const CATEGORIES: string[] = (content.photography?.categories ?? []).map((c: string) => c.toLowerCase());

      async function shrink(file: File, max = 1600) {
        const img = await createImageBitmap(file);
        const scale = Math.min(1, max / Math.max(img.width, img.height));
        const w = Math.round(img.width * scale);
        const h = Math.round(img.height * scale);
        const canvas = new OffscreenCanvas(w, h);
        canvas.getContext('2d')!.drawImage(img, 0, 0, w, h);
        const blob = await canvas.convertToBlob({ type: 'image/webp', quality: 0.85 });
        return { blob, w, h };
      }

      function mediaCard(t: 'gallery' | 'brands', row: any, rows: any[]) {
        const card = document.createElement('figure');
        card.className = 'card';
        card.innerHTML = `<img src="/media/${row.r2_key}" loading="lazy" alt="" />`;

        if (t === 'gallery') {
          const cats: string[] = JSON.parse(row.categories ?? '[]');
          const chipRow = document.createElement('div');
          chipRow.className = 'chips';
          for (const c of CATEGORIES) {
            const chip = document.createElement('button');
            chip.textContent = c;
            chip.className = cats.includes(c) ? 'chip on' : 'chip';
            chip.addEventListener('click', async () => {
              const next = cats.includes(c) ? cats.filter((x) => x !== c) : [...cats, c];
              await api(`/api/admin/media?table=gallery`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: row.id, categories: next }),
              });
              row.categories = JSON.stringify(next);
              cats.length = 0;
              cats.push(...next);
              chip.classList.toggle('on');
              flash('Categories updated.');
            });
            chipRow.appendChild(chip);
          }
          card.appendChild(chipRow);
        }

        if (t === 'brands') {
          card.classList.toggle('off', !row.enabled);
          const label = document.createElement('input');
          label.className = 'brand-label';
          label.placeholder = 'Label (optional)';
          label.value = row.label ?? '';
          label.addEventListener('change', async () => {
            await api('/api/admin/media?table=brands', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: row.id, label: label.value }),
            });
            row.label = label.value;
            flash('Label saved.');
          });
          card.appendChild(label);
        }

        const actions = document.createElement('div');
        actions.className = 'actions';
        const move = async (delta: number) => {
          const i = rows.indexOf(row);
          const j = i + delta;
          if (j < 0 || j >= rows.length) return;
          [rows[i], rows[j]] = [rows[j], rows[i]];
          await api(`/api/admin/media?table=${t}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order: rows.map((r) => r.id) }),
          });
          renderMedia(t, rows);
        };
        if (t === 'brands') {
          const vis = document.createElement('button');
          vis.textContent = row.enabled ? 'Shown' : 'Hidden';
          vis.className = row.enabled ? 'chip on' : 'chip';
          vis.addEventListener('click', async () => {
            row.enabled = row.enabled ? 0 : 1;
            await api('/api/admin/media?table=brands', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: row.id, enabled: !!row.enabled }),
            });
            renderMedia(t, rows);
            flash(row.enabled ? 'Tile shown on the site.' : 'Tile hidden from the site.');
          });
          actions.appendChild(vis);
        }
        for (const [label, fn] of [
          ['←', () => move(-1)],
          ['→', () => move(1)],
          ['Delete', async () => {
            if (!confirm('Delete this image permanently?')) return;
            await api(`/api/admin/media?table=${t}&id=${row.id}`, { method: 'DELETE' });
            rows.splice(rows.indexOf(row), 1);
            renderMedia(t, rows);
            flash('Deleted.');
          }],
        ] as const) {
          const b = document.createElement('button');
          b.textContent = label;
          b.className = label === 'Delete' ? 'chip danger' : 'chip';
          b.addEventListener('click', fn);
          actions.appendChild(b);
        }
        card.appendChild(actions);
        return card;
      }

      function renderMedia(t: 'gallery' | 'brands', rows: any[]) {
        const grid = $(`#${t}-grid`);
        grid.replaceChildren(...rows.map((r) => mediaCard(t, r, rows)));
      }

      for (const t of ['gallery', 'brands'] as const) {
        const rows: any[] = await api(`/api/admin/media?table=${t}`);
        renderMedia(t, rows);
        ($(`#${t}-files`) as HTMLInputElement).addEventListener('change', async (e) => {
          const files = [...((e.target as HTMLInputElement).files ?? [])];
          for (const f of files) {
            flash(`Uploading ${f.name}…`);
            const { blob, w, h } = await shrink(f, t === 'gallery' ? 1600 : 600);
            const fd = new FormData();
            fd.append('file', new File([blob], f.name.replace(/\.\w+$/, '.webp'), { type: 'image/webp' }));
            fd.append('w', String(w));
            fd.append('h', String(h));
            if (t === 'gallery') fd.append('categories', '[]');
            await api(`/api/admin/media?table=${t}`, { method: 'POST', body: fd });
          }
          renderMedia(t, await api(`/api/admin/media?table=${t}`));
          flash(`${files.length} image(s) uploaded — live immediately.`);
        });
      }

      // ---- enquiries ----
      const enquiries: any[] = await api('/api/admin/enquiries');
      const enqTab = $('#tab-enquiries');
      if (!enquiries.length) {
        enqTab.innerHTML = '<p class="empty">No enquiries yet.</p>';
      } else {
        const table = document.createElement('table');
        table.innerHTML = '<thead><tr><th>When</th><th>Name</th><th>Email</th><th>Phone</th><th>Message</th></tr></thead>';
        const tbody = document.createElement('tbody');
        for (const q of enquiries) {
          const tr = document.createElement('tr');
          for (const v of [q.created_at, `${q.first_name} ${q.last_name}`, q.email, q.phone || '—', q.message]) {
            const td = document.createElement('td');
            td.textContent = v;
            tr.appendChild(td);
          }
          tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        enqTab.appendChild(table);
      }
    </script>

    <style is:global>
      .bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        padding: 1rem var(--gutter);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: var(--ink);
        z-index: 10;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .brand em { font-style: normal; color: var(--teal); }
      .brand .mark { width: 1.3rem; height: 1.3rem; color: var(--teal); }
      .tabs { display: flex; gap: 0.4rem; }
      .tabs button {
        font-family: var(--font-label);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mist);
        background: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.5rem 1.1rem;
        cursor: pointer;
      }
      .tabs button.is-active { color: var(--ink); background: var(--teal); border-color: var(--teal); }
      .panel { max-width: 72rem; margin-inline: auto; padding: 1.5rem var(--gutter) 4rem; }
      .status {
        position: fixed;
        bottom: 1.2rem;
        right: 1.2rem;
        z-index: 20;
        border: 1px solid var(--teal);
        color: var(--teal-hi);
        background: var(--ink-2);
        padding: 0.7rem 1rem;
        font-size: 0.9rem;
      }
      .status.is-error { border-color: #c4544d; color: #e08a84; }
      details {
        border: 1px solid var(--line);
        margin-bottom: 0.6rem;
      }
      summary {
        cursor: pointer;
        padding: 0.9rem 1.1rem;
        font-family: var(--font-label);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      details > div { padding: 0 1.1rem 1.1rem; }
      fieldset { border: 1px solid var(--line); padding: 0.8rem; margin-block: 0.6rem; }
      legend {
        font-family: var(--font-label);
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--teal);
        padding-inline: 0.4rem;
      }
      .field label {
        display: grid;
        gap: 0.3rem;
        margin-block: 0.5rem;
        font-family: var(--font-label);
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mist);
      }
      input, textarea {
        font: 0.95rem var(--font-body);
        color: var(--paper);
        background: var(--ink-2);
        border: 1px solid var(--line);
        padding: 0.6rem 0.8rem;
        resize: vertical;
      }
      input:focus, textarea:focus { outline: none; border-color: var(--teal); }
      .btn-save, .upload {
        display: inline-block;
        font-family: var(--font-label);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--teal);
        border: 0;
        padding: 0.7rem 1.6rem;
        cursor: pointer;
        margin-top: 0.8rem;
      }
      .upload input { display: none; }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
        gap: 0.8rem;
        margin-top: 1.2rem;
      }
      .grid-small { grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); }
      .card { border: 1px solid var(--line); padding: 0.5rem; margin: 0; }
      .card.off img { opacity: 0.35; }
      .brand-label { width: 100%; margin-top: 0.5rem; font-size: 0.85rem; padding: 0.4rem 0.6rem; }
      .card img { width: 100%; height: 9rem; object-fit: cover; display: block; }
      .grid-small .card img { height: 6rem; object-fit: contain; }
      .chips, .actions { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
      .chip {
        font-family: var(--font-label);
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--mist);
        background: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.25rem 0.6rem;
        cursor: pointer;
      }
      .chip.on { color: var(--ink); background: var(--teal); border-color: var(--teal); }
      .chip.danger { color: #e08a84; border-color: #c4544d; margin-left: auto; }
      .list-item { display: flex; gap: 0.6rem; align-items: flex-start; }
      .list-item > .field { flex: 1; min-width: 0; }
      .item-ctl { display: flex; flex-direction: column; gap: 0.3rem; padding-top: 0.9rem; }
      .item-ctl .chip.danger { margin-left: 0; }
      .field label.check { display: flex; align-items: center; gap: 0.5rem; }
      .field label.check input { accent-color: var(--teal); width: 1rem; height: 1rem; }
      table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      th, td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      th {
        font-family: var(--font-label);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--teal);
      }
      .empty { color: var(--mist); }
    </style>
  </body>
</html>
