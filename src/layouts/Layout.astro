---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoLockup from '../assets/logo-lockup.png';
import { meta, nav, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, meta.url)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, meta.url)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // set the theme before first paint to avoid a flash of the wrong theme
      document.documentElement.dataset.theme =
        localStorage.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    </script>
  </head>
  <body>
    <header class="site-header always-dark" id="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/#top" aria-label="Discover With Leigh — home">
          <Image src={logoLockup} alt="Discover With Leigh — marketing content creation" widths={[240, 480]} sizes="10rem" class="brand-lockup" />
        </a>
        <div class="header-right">
          <nav class="site-nav" id="site-nav" aria-label="Main">
            <ul>
              {nav.map((item) => (
                <li><a href={`/${item.href}`}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <button class="theme-toggle" id="theme-toggle" aria-label="Switch colour theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
          </button>
          <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="site-footer always-dark">
      <div class="wrap footer-inner">
        <Image src={logoLockup} alt="Discover With Leigh" widths={[360, 720]} sizes="14rem" class="signature-lockup" loading="lazy" />
        <div class="footer-legal">
          <p><a href="/privacy-policy">Privacy Policy</a></p>
          <p>&copy; {new Date().getFullYear()} Discover With Leigh. All rights reserved.</p>
          <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>
      </div>
    </footer>

    <script>
      // header state + mobile nav
      const header = document.getElementById('site-header')!;
      const toggle = document.getElementById('nav-toggle')!;
      const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
      toggle.addEventListener('click', () => {
        const open = header.toggleAttribute('data-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      header.querySelectorAll('.site-nav a').forEach((a) =>
        a.addEventListener('click', () => {
          header.removeAttribute('data-open');
          toggle.setAttribute('aria-expanded', 'false');
        }),
      );

      // theme toggle (initial theme is set pre-paint in <head>)
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.theme = next;
      });

      // scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      .site-header {
        position: fixed;
        inset-inline: 0;
        top: 0;
        z-index: 50;
        transition: background-color 0.3s;
      }
      .site-header[data-scrolled] {
        background: color-mix(in srgb, var(--ink) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4.25rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
      }
      .brand :global(.brand-lockup) {
        height: 3rem;
        width: auto;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .theme-toggle {
        display: grid;
        place-items: center;
        background: none;
        border: 0;
        padding: 0.4rem;
        cursor: pointer;
        color: var(--paper);
        transition: color 0.2s;
      }
      .theme-toggle:hover {
        color: var(--teal-hi);
      }
      .theme-toggle svg {
        width: 1.15rem;
        height: 1.15rem;
      }
      .theme-toggle .icon-moon {
        display: none;
      }
      :global([data-theme='light']) .theme-toggle .icon-sun {
        display: none;
      }
      :global([data-theme='light']) .theme-toggle .icon-moon {
        display: block;
      }
      .site-nav ul {
        display: flex;
        gap: 2rem;
        list-style: none;
      }
      .site-nav a {
        font-family: var(--font-label);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--paper);
        transition: color 0.2s;
      }
      .site-nav a:hover {
        color: var(--teal-hi);
      }
      .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 6px;
        background: none;
        border: 0;
        padding: 0.5rem;
        cursor: pointer;
      }
      .nav-toggle span {
        width: 26px;
        height: 2px;
        background: var(--paper);
        transition: rotate 0.25s, translate 0.25s;
      }
      @media (max-width: 760px) {
        .nav-toggle {
          display: flex;
        }
        .site-nav {
          position: fixed;
          inset: 4.25rem 0 auto 0;
          background: var(--ink);
          border-bottom: 1px solid var(--line);
          padding: 1.5rem var(--gutter) 2rem;
          display: none;
        }
        .site-header[data-open] {
          background: var(--ink);
        }
        .site-header[data-open] .site-nav {
          display: block;
        }
        .site-header[data-open] .nav-toggle span:first-child {
          rotate: 45deg;
          translate: 0 4px;
        }
        .site-header[data-open] .nav-toggle span:last-child {
          rotate: -45deg;
          translate: 0 -4px;
        }
        .site-nav ul {
          flex-direction: column;
          gap: 1.25rem;
        }
      }

      .site-footer {
        background: var(--ink); /* always-dark: visible as a black band in light mode */
        border-top: 1px solid var(--line);
        padding-block: 3rem;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
        justify-content: space-between;
      }
      .footer-inner :global(.signature-lockup) {
        width: clamp(11rem, 22vw, 14rem);
        height: auto;
        opacity: 0.9;
      }
      .footer-legal {
        text-align: right;
        font-size: 0.85rem;
        color: var(--mist);
        display: grid;
        gap: 0.35rem;
      }
      .footer-legal a {
        color: var(--mist);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .footer-legal a:hover {
        color: var(--teal-hi);
      }
      @media (max-width: 700px) {
        .footer-inner {
          justify-content: center;
        }
        .footer-legal {
          text-align: center;
        }
      }
    </style>
  </body>
</html>
