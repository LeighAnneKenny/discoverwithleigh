---
import Eyebrow from './Eyebrow.astro';
import type { MediaItem } from '../lib/content';

const { items } = Astro.props as { items: MediaItem[] };

const n = items.length;
const split = Math.ceil(n / 2);
const topItems = items.slice(0, split);
const bottomItems = items.slice(split);
const isSingle = bottomItems.length === 0;

// Each animated half must exceed the container width — repeat until ≥ 10 tiles per half
const topRepeats = Math.max(1, Math.ceil(10 / Math.max(1, topItems.length)));
const botRepeats = isSingle ? 0 : Math.max(1, Math.ceil(10 / Math.max(1, bottomItems.length)));

type TileData = { logo: MediaItem; frameNum: string; hiddenDup: boolean };

function buildHalf(rowItems: MediaItem[], repeats: number, frameOffset: number): TileData[] {
  const result: TileData[] = [];
  for (let rep = 0; rep < repeats; rep++) {
    for (let i = 0; i < rowItems.length; i++) {
      result.push({
        logo: rowItems[i],
        frameNum: String(frameOffset + rep * rowItems.length + i + 1).padStart(2, '0') + 'A',
        hiddenDup: rep > 0,
      });
    }
  }
  return result;
}

const topHalf = buildHalf(topItems, topRepeats, 0);
const botHalf = isSingle ? [] : buildHalf(bottomItems, botRepeats, split);
---

<section class="section" id="brands">
  <div class="wrap reveal">
    <Eyebrow>Trusted collaborations</Eyebrow>
    <h2 class="section-heading">Brands I've worked with</h2>
  </div>
  <div class="wrap reveal">
    <div class="film-shadow">
    <div class="film-marquee" role="group" aria-label="Client brand logos">

      <div class="film-strip">
        <div class="strip-scroller">
          <div class="strip-track strip-track--fwd">
            {[0, 1].map((dupHalf) => (
              <div class="strip-half" aria-hidden={dupHalf === 1 ? 'true' : undefined}>
                {topHalf.map(({ logo, frameNum, hiddenDup }) => (
                  <figure
                    class="brand-tile"
                    aria-hidden={dupHalf === 0 && hiddenDup ? 'true' : undefined}
                  >
                    <span class="frame-num" aria-hidden="true">{frameNum}</span>
                    <img src={logo.url} width={logo.w} height={logo.h} alt="" loading="lazy" decoding="async" />
                    {logo.label && <figcaption>{logo.label}</figcaption>}
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      {!isSingle && (
        <div class="film-strip">
          <div class="strip-scroller">
            <div class="strip-track strip-track--rev">
              {[0, 1].map((dupHalf) => (
                <div class="strip-half" aria-hidden={dupHalf === 1 ? 'true' : undefined}>
                  {botHalf.map(({ logo, frameNum, hiddenDup }) => (
                    <figure
                      class="brand-tile"
                      aria-hidden={dupHalf === 0 && hiddenDup ? 'true' : undefined}
                    >
                      <span class="frame-num" aria-hidden="true">{frameNum}</span>
                      <img src={logo.url} width={logo.w} height={logo.h} alt="" loading="lazy" decoding="async" />
                      {logo.label && <figcaption>{logo.label}</figcaption>}
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

    </div>
    </div>
  </div>
</section>

<style>
  /* Shadow as symmetric top/bottom bands — vertical pop only, no side
     spill (drop-shadow blur is radial, it can't do directional-only).
     The bands wear the same edge-fade mask as the marquee so they die
     out with the film ends. Dark theme lifts them to grey via --shadow. */
  .film-shadow {
    position: relative;
    margin-top: 1rem;
  }

  .film-shadow::before,
  .film-shadow::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.4rem;
    pointer-events: none;
    --shadow: 7 9 8;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .film-shadow::before {
    bottom: 100%;
    background: linear-gradient(to top, rgb(var(--shadow) / 0.32), rgb(var(--shadow) / 0.1) 55%, transparent);
  }

  .film-shadow::after {
    top: 100%;
    background: linear-gradient(to bottom, rgb(var(--shadow) / 0.32), rgb(var(--shadow) / 0.1) 55%, transparent);
  }

  :global([data-theme='dark']) .film-shadow::before,
  :global([data-theme='dark']) .film-shadow::after {
    --shadow: 160 168 164;
  }

  /* ---- outer container: clips both strips, applies edge-fade mask ---- */
  .film-marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* Pause both rows when hovering anywhere on the marquee.
     Hover devices only: on touch, :hover sticks after a tap and froze the
     strip until the user tapped elsewhere — touch pause lives in the script. */
  @media (hover: hover) {
    .film-marquee:hover .strip-track {
      animation-play-state: paused;
    }
  }

  /* ---- film strip: dark base + sprocket bands via ::before/::after ---- */
  .film-strip {
    /* Force dark film-base in both themes — real film is dark.
       ponytail: mirrors .always-dark's values; can't reuse the class — it also
       sets color: var(--paper), which the tiles don't want */
    --ink: #0b0d0d;
    --line: #242b29;
    --mist: #97a09c;
    background: #0b0d0d;
    display: flex;
    flex-direction: column;
  }

  /* Sprocket-hole bands: white KS-style perforations (landscape rectangles,
     ~1.4:1 like real 35mm) punched through the dark bar. The gradient paints
     one perf per 1.4rem tile; origin/clip content-box insets it vertically. */
  .film-strip::before,
  .film-strip::after {
    content: '';
    display: block;
    height: 0.7rem;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 0.16rem 0;
    background-image: linear-gradient(90deg, transparent 0.425rem, #f2f0ea 0.425rem 0.975rem, transparent 0.975rem);
    background-size: 1.4rem 100%;
    background-origin: content-box;
    background-clip: content-box;
  }

  /* Touch devices swipe the strips natively; the script below pauses the
     marquee while a finger is down and resumes 2s after the last activity.
     The scroller wraps only the track, so the static sprocket bands keep
     their full width while the frames scroll between them. */
  @media (hover: none) {
    .strip-scroller {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .strip-scroller::-webkit-scrollbar {
      display: none;
    }
  }

  /* Swipe mode (set by the script): animation off zeroes the translate so
     each strip's position lives in scrollLeft instead. */
  .film-marquee.is-swiping .strip-track {
    animation: none;
  }

  /* ---- animated track ---- */
  .strip-track {
    display: flex;
    width: max-content;
  }

  /* Two identical halves; animating the whole track by -50% loops seamlessly */
  @keyframes brands-marquee {
    to { translate: -50% 0; }
  }

  .strip-track--fwd {
    animation: brands-marquee 50s linear infinite;
  }

  .strip-track--rev {
    animation: brands-marquee 62s linear infinite;
    animation-direction: reverse;
  }

  /* ---- half: row of tiles ---- */
  .strip-half {
    display: flex;
    gap: 1px;
    padding-right: 1px; /* maintains 1px seam at the loop point */
  }

  /* ---- individual frame (brand tile) ---- */
  .brand-tile {
    position: relative;
    flex: none;
    width: 9.5rem;
    aspect-ratio: 1;
    margin: 0;
    padding: 1.2rem;
    background: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.5rem;
  }

  .brand-tile img {
    max-width: 100%;
    max-height: 5.5rem;
    width: auto;
    height: auto;
    /* Colour by default; hovering/focusing a frame greys out its row-mates
       (below) instead — film base is dark in both themes */
    filter: none;
    opacity: 1;
    transition: filter 0.3s, opacity 0.3s;
  }

  /* Scoped to an actual frame hover — a bare .film-marquee:hover would grey
     every logo with none highlighted when the pointer is over the sprocket-band
     gaps between frames. Marquee-wide, matching the pause above: both rows
     freeze, so both rows dim.
     ponytail: hover-only by design. The tiles are decorative <figure>s (alt="",
     no link), and most sit inside aria-hidden marquee duplicates — making them
     focusable to mirror this on :focus-visible would add ~56 tab stops and trip
     axe's aria-hidden-focus rule. Add the :focus-visible twin if tiles ever
     become links. Hover devices only — see the pause rule above. */
  @media (hover: hover) {
    .film-marquee:has(.brand-tile:hover) .brand-tile:not(:hover) img {
      filter: grayscale(1) brightness(1.6);
      opacity: 0.75;
    }
  }

  .brand-tile figcaption {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mist);
    text-align: center;
  }

  /* Decorative contact-sheet frame number — purely visual, aria-hidden */
  .frame-num {
    position: absolute;
    top: 0.25rem;
    right: 0.3rem;
    font-family: var(--font-label);
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--mist);
    opacity: 0.4;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* ---- reduced motion: static scrollable strips, no animation ---- */
  @media (prefers-reduced-motion: reduce) {
    .film-marquee {
      overflow: visible;
      mask-image: none;
    }
    .film-shadow::before,
    .film-shadow::after {
      mask-image: none;
    }
    /* Scroll on the scroller, not .film-strip — keeps the sprocket bands
       full-width instead of ending at the viewport edge when scrolled */
    .strip-scroller {
      overflow-x: auto;
    }
    .strip-track {
      animation: none;
    }
    /* Hide duplicates — only show one copy of each brand */
    .strip-half[aria-hidden='true'],
    .brand-tile[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  // Touch companion to the hover-gated rules above. A touch pauses the marquee
  // by handing each track to native scrolling — translate -X on a duplicated
  // track paints the same frame as scrollLeft X — so a swipe browses the strip;
  // 2s after the last touch or momentum-scroll event the animation takes back
  // over from wherever each strip was left.
  const marquee = document.querySelector<HTMLElement>('.film-marquee');
  const touch = matchMedia('(hover: none)').matches;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Wherever the CSS makes the scrollers scrollable (touch always,
  // reduced-motion everywhere), give them keyboard access + a name —
  // axe: scrollable-region-focusable.
  if (marquee && (touch || reduced)) {
    marquee.querySelectorAll('.strip-scroller').forEach((el, i) => {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'group');
      el.setAttribute('aria-label', `Brand logos, row ${i + 1}, scrollable`);
    });
  }

  if (marquee && touch && !reduced) {
    const rows = [...marquee.querySelectorAll<HTMLElement>('.strip-scroller')].map((scroller) => ({
      scroller,
      track: scroller.querySelector<HTMLElement>('.strip-track')!,
    }));
    let swiping = false;
    let touching = false;
    let timer: ReturnType<typeof setTimeout>;

    // Animation progress ↔ px the track sits left of its resting position.
    // The reversed (bottom) row plays its keyframes backwards, hence 1 - p.
    const half = (track: HTMLElement) => track.offsetWidth / 2;
    const readX = (track: HTMLElement) => {
      const anim = track.getAnimations()[0];
      if (!anim) return 0;
      const { duration, direction } = anim.effect!.getComputedTiming();
      const p = (Number(anim.currentTime ?? 0) % (duration as number)) / (duration as number);
      return (direction === 'reverse' ? 1 - p : p) * half(track);
    };
    const seekTo = (track: HTMLElement, x: number) => {
      const anim = track.getAnimations()[0];
      if (!anim) return;
      const { duration, direction } = anim.effect!.getComputedTiming();
      const p = direction === 'reverse' ? 1 - x / half(track) : x / half(track);
      anim.currentTime = p * (duration as number);
    };

    const enterSwipe = () => {
      if (swiping) return;
      swiping = true;
      const offsets = rows.map(({ track }) => readX(track));
      marquee.classList.add('is-swiping'); // kills the animations — read first
      rows.forEach(({ scroller }, i) => (scroller.scrollLeft = offsets[i]));
    };
    const resume = () => {
      swiping = false;
      const offsets = rows.map(({ scroller, track }) => scroller.scrollLeft % half(track));
      marquee.classList.remove('is-swiping'); // fresh animations start at 0…
      rows.forEach(({ scroller, track }, i) => {
        seekTo(track, offsets[i]); // …seek each to where the user left it
        scroller.scrollLeft = 0;
      });
    };
    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(resume, 2000);
    };

    marquee.addEventListener(
      'touchstart',
      () => {
        touching = true;
        clearTimeout(timer);
        enterSwipe();
      },
      { passive: true },
    );
    const release = (e: TouchEvent) => {
      touching = e.touches.length > 0;
      if (!touching) schedule();
    };
    marquee.addEventListener('touchend', release, { passive: true });
    marquee.addEventListener('touchcancel', release, { passive: true });
    for (const { scroller } of rows) {
      // momentum after release keeps the pause alive until scrolling settles
      scroller.addEventListener('scroll', () => swiping && !touching && schedule(), {
        passive: true,
      });
    }
  }
</script>
