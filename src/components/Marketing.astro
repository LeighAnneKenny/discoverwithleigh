---
import Eyebrow from './Eyebrow.astro';
import type { SiteContent } from '../lib/content';

const { marketing } = Astro.props as { marketing: SiteContent['marketing'] };
---
<section class="section" id="marketing">
  <div class="wrap">
    <div class="reveal">
      <Eyebrow>{marketing.eyebrow}</Eyebrow>
      <h2 class="section-heading">{marketing.heading}</h2>
      {marketing.body.map((p) => <p class="lede">{p}</p>)}
    </div>

    <h3 class="process-title reveal">{marketing.processTitle}</h3>
    <ol class="process">
      {marketing.process.map((step, i) => (
        <li class="reveal">
          <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
          <h4>{step.name}</h4>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-title {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    letter-spacing: 0.14em;
    margin-block: 3.5rem 2rem;
    color: var(--teal);
  }
  .process {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .process li {
    background: var(--ink);
    padding: 2rem 1.6rem 2.2rem;
  }
  .step-no {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--line);
    -webkit-text-stroke: 1px var(--teal);
    margin-bottom: 1.2rem;
  }
  .process h4 {
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .process p {
    font-size: 0.95rem;
    color: var(--mist);
  }
</style>
