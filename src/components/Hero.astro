---
import { Image } from 'astro:assets';
import Aperture from './Aperture.astro';
import heroBg from '../assets/hero-bg.jpg';
import type { SiteContent } from '../lib/content';

const { hero } = Astro.props as { hero: SiteContent['hero'] };
---
<section class="hero">
  <Image
    src={heroBg}
    alt=""
    widths={[820, 1400, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-bg"
  />
  <div class="hero-inner wrap">
    <h1 class="hero-title" translate="no">
      Disc<Aperture class="hero-aperture" /><span class="sr-only">o</span>ver
      <span class="hero-sub-line">with Leigh</span>
    </h1>
    <p class="hero-tag">{hero.subtitle}</p>
    <a class="btn" href="#contact">Let’s work together</a>
  </div>
  <a class="hero-cue" href="#about" aria-label="Scroll to about section">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.42) saturate(0.9);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(11 13 13 / 0.35), transparent 40%, var(--ink));
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: 8rem 6rem;
  }
  .hero-title {
    font-size: clamp(3rem, 11vw, 8.5rem);
    letter-spacing: 0.06em;
    display: block;
  }
  .hero-title :global(.hero-aperture) {
    display: inline-block;
    width: 0.72em;
    height: 0.72em;
    color: var(--teal);
    vertical-align: baseline;
    margin-inline: 0.02em;
  }
  /* shutter opening: blades sweep from closed to open around their rim pivots */
  .hero-title :global(.hero-aperture .blade) {
    transform-box: view-box;
    animation: blade-open 1.4s cubic-bezier(0.7, 0, 0.25, 1) 0.25s both;
  }
  @keyframes blade-open {
    from {
      rotate: 24deg;
    }
    to {
      rotate: 0deg;
    }
  }
  .hero-sub-line {
    display: block;
    font-size: 0.32em;
    letter-spacing: 0.5em;
    margin-top: 0.4rem;
    color: var(--paper);
  }
  .hero-tag {
    font-family: var(--font-label);
    font-size: clamp(0.72rem, 1.6vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mist);
    margin: 1.6rem 0 2.4rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .hero-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    width: 1.4rem;
    height: 2.4rem;
    border: 1px solid var(--mist);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 0.5rem;
  }
  .hero-cue span {
    width: 2px;
    height: 0.55rem;
    background: var(--teal-hi);
    border-radius: 2px;
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { translate: 0 0; opacity: 1; }
    50% { translate: 0 0.5rem; opacity: 0.3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title :global(.hero-aperture .blade),
    .hero-cue span {
      animation: none;
    }
  }
</style>
