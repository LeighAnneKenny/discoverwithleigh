---
import { Image } from 'astro:assets';
import Aperture from './Aperture.astro';
import heroBg from '../assets/hero-bg.jpg';
import type { SiteContent } from '../lib/content';

const { hero } = Astro.props as { hero: SiteContent['hero'] };
---
<section class="hero">
  <Image
    src={heroBg}
    alt=""
    widths={[820, 1400, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-bg"
  />
  <div class="hero-inner wrap">
    <h1 class="hero-title" translate="no">
      Disc<Aperture class="hero-aperture" /><span class="sr-only">o</span>ver
      <span class="hero-sub-line">with Leigh</span>
    </h1>
    <p class="hero-tag">{hero.subtitle}</p>
    <a class="btn" href="#contact">Let’s work together</a>
  </div>
  <a class="hero-cue" href="#about" aria-label="Scroll to about section">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* text sits over the darkened photo — pin dark-theme colours in both themes
       (--ink is NOT pinned: the bottom gradient must fade into the page background) */
    --paper: #f2f1ec;
    --mist: #97a09c;
    --teal: #00a79d;
    --teal-hi: #2bd9cd;
    color: var(--paper); /* re-anchor inherited text colour to the pinned value */
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.42) saturate(0.9);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(11 13 13 / 0.35), transparent 40%, var(--ink));
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: 8rem 6rem;
  }
  .hero-title {
    font-size: clamp(3rem, 11vw, 8.5rem);
    letter-spacing: 0.06em;
    display: block;
  }
  .hero-title :global(.hero-aperture) {
    display: inline-block;
    width: 0.72em;
    height: 0.72em;
    color: var(--teal);
    vertical-align: baseline;
    margin-inline: 0.02em;
  }
  /* shutter click on load: open → snap closed (the capture) → reopen.
     Real iris mechanics (PRD item 14): each blade rotates about its rim
     pivot so the blade lines sweep inward as the hole closes; the clipPath
     housing in Aperture.astro keeps the outer edge immovable. */
  .hero-title :global(.hero-aperture .blade) {
    transform-box: view-box;
    /* the seam lines: each blade's edge drawn over the blade it overlaps, so
       the lines stay visible (sharpening into the pinhole) instead of
       vanishing when same-colour blades overlap. Invisible at rest. */
    stroke: rgb(0 0 0 / 0.3);
    stroke-width: 1;
    stroke-linejoin: round;
    stroke-opacity: 0;
    animation: blade-click 1.7s 0.5s both;
  }
  @keyframes blade-click {
    0% {
      rotate: 0deg;
      stroke-opacity: 0;
      animation-timing-function: cubic-bezier(0.6, 0, 0.9, 0.4);
    }
    15% {
      stroke-opacity: 1;
    }
    /* 14°: stops down to a small pore with the seam lines converging into it
       (like the reference photo) — more rotation makes the centre tangle */
    38% {
      rotate: 14deg;
      animation-timing-function: linear;
    }
    50% {
      rotate: 14deg;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.3, 1);
    }
    85% {
      stroke-opacity: 1;
    }
    100% {
      rotate: 0deg;
      stroke-opacity: 0;
    }
  }
  .hero-sub-line {
    display: block;
    font-size: 0.32em;
    letter-spacing: 0.5em;
    margin-top: 0.4rem;
    color: var(--paper);
  }
  .hero-tag {
    font-family: var(--font-label);
    font-size: clamp(0.72rem, 1.6vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mist);
    margin: 1.6rem 0 2.4rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .hero-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    width: 1.4rem;
    height: 2.4rem;
    border: 1px solid var(--mist);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 0.5rem;
  }
  .hero-cue span {
    width: 2px;
    height: 0.55rem;
    background: var(--teal-hi);
    border-radius: 2px;
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue {
    0%, 100% { translate: 0 0; opacity: 1; }
    50% { translate: 0 0.5rem; opacity: 0.3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title :global(.hero-aperture .blade),
    .hero-cue span {
      animation: none;
    }
  }
</style>
