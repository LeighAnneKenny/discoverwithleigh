---
import Eyebrow from './Eyebrow.astro';
import type { SiteContent, MediaItem } from '../lib/content';

const { photography, items } = Astro.props as { photography: SiteContent['photography']; items: MediaItem[] };
---
<section class="section" id="photography">
  <div class="wrap">
    <div class="reveal">
      <Eyebrow>{photography.eyebrow}</Eyebrow>
      <h2 class="section-heading">{photography.heading}</h2>
      <p class="lede">{photography.body}</p>
    </div>

    <div class="tabs reveal" role="group" aria-label="Filter gallery by category">
      <button class="tab is-active" data-filter="all" aria-pressed="true">All</button>
      {photography.categories.map((c) => (
        <button class="tab" data-filter={c.toLowerCase()} aria-pressed="false">{c}</button>
      ))}
    </div>
  </div>

  <div class="carousel reveal">
    <button class="arrow arrow-prev" id="gallery-prev" aria-label="Previous photos">&#8592;</button>
    <div class="track" id="gallery-track" tabindex="0" role="region" aria-label="Photography gallery — scrolls horizontally">
      {items.map(({ url, w, h, categories }) => (
        <button class="shot" data-cats={categories.join(',')} aria-label={`View photo — ${categories.join(', ') || 'photography'}`}>
          <img src={url} width={w} height={h} alt="" loading="lazy" decoding="async" />
          {categories[0] && <span class="shot-tag">{categories[0]}</span>}
        </button>
      ))}
    </div>
    <button class="arrow arrow-next" id="gallery-next" aria-label="Next photos">&#8594;</button>
  </div>

  <dialog class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <img id="lightbox-img" src="" alt="Enlarged photograph" />
  </dialog>
</section>

<script>
  const track = document.getElementById('gallery-track')!;
  const shots = [...track.querySelectorAll<HTMLElement>('.shot')];
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  tabs.forEach((btn) =>
    btn.addEventListener('click', () => {
      tabs.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      const f = btn.dataset.filter!;
      shots.forEach((s) => {
        s.hidden = f !== 'all' && !s.dataset.cats!.split(',').includes(f);
      });
      track.scrollTo({ left: 0 });
    }),
  );

  const page = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: smooth });
  document.getElementById('gallery-prev')!.addEventListener('click', () => page(-1));
  document.getElementById('gallery-next')!.addEventListener('click', () => page(1));

  const box = document.getElementById('lightbox') as HTMLDialogElement;
  const boxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  shots.forEach((s) =>
    s.addEventListener('click', () => {
      boxImg.src = s.querySelector('img')!.src;
      box.showModal();
    }),
  );
  document.getElementById('lightbox-close')!.addEventListener('click', () => box.close());
  box.addEventListener('click', (e) => {
    if (e.target === box) box.close();
  });
</script>

<style>
  .tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
    margin-block: 2.2rem 2.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mist);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.7rem 1rem;
    margin-bottom: -1px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .tab:hover {
    color: var(--paper);
  }
  .tab.is-active {
    color: var(--teal-hi);
    border-bottom-color: var(--teal);
  }

  .carousel {
    position: relative;
  }
  .track {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .shot[hidden] {
    display: none;
  }
  .shot {
    position: relative;
    flex: 0 0 auto;
    height: clamp(17rem, 52vh, 26rem);
    scroll-snap-align: start;
    padding: 0;
    border: 0;
    background: var(--ink-2);
    cursor: zoom-in;
    overflow: hidden;
  }
  .shot img {
    height: 100%;
    width: auto;
    display: block;
    transition: scale 0.5s ease, opacity 0.5s ease;
  }
  .shot:hover img {
    scale: 1.04;
    opacity: 0.85;
  }
  .shot-tag {
    position: absolute;
    left: 0.7rem;
    bottom: 0.6rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #f2f1ec; /* over a fixed dark chip in both themes */
    background: rgb(11 13 13 / 0.72);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .shot:hover .shot-tag,
  .shot:focus-visible .shot-tag {
    opacity: 1;
  }
  .arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(6px);
    color: var(--paper);
    font-size: 1.1rem;
    cursor: pointer;
    display: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .arrow:hover {
    color: var(--teal-hi);
    border-color: var(--mist);
  }
  .arrow-prev {
    left: 0.9rem;
  }
  .arrow-next {
    right: 0.9rem;
  }
  @media (min-width: 761px) {
    .arrow {
      display: grid;
      place-items: center;
    }
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 70rem);
    max-height: 90vh;
  }
  .lightbox::backdrop {
    background: rgb(11 13 13 / 0.92);
  }
  .lightbox img {
    max-height: 86vh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
  }
  .lightbox-close {
    position: fixed;
    top: 0.6rem;
    right: 1rem;
    font-size: 2.2rem;
    line-height: 1;
    color: #f2f1ec; /* over the fixed dark backdrop in both themes */
    background: none;
    border: 0;
    cursor: pointer;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot img {
      transition: none;
    }
  }
</style>
