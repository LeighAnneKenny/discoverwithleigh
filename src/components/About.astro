---
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import portrait from '../assets/about-leigh.jpg';
import { about, services } from '../data/site';
---
<section class="section" id="about">
  <div class="wrap about-grid">
    <figure class="about-figure reveal">
      <Image src={portrait} alt="Leigh-Anne Kenny, photographer, holding her camera" widths={[480, 760, 980]} sizes="(max-width: 900px) 92vw, 44vw" />
    </figure>
    <div class="about-copy reveal">
      <Eyebrow>{about.eyebrow}</Eyebrow>
      <h2 class="section-heading">{about.heading}</h2>
      {about.body.map((p) => <p class="lede">{p}</p>)}
      <ul class="services" aria-label="Services">
        {services.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
      <a class="btn" href="#contact">{about.cta}</a>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .about-figure {
    position: relative;
  }
  .about-figure::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--teal);
    z-index: -1;
  }
  .services {
    list-style: none;
    margin-block: 1.8rem 2.2rem;
    border-top: 1px solid var(--line);
  }
  .services li {
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .services li::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--teal);
    margin-right: 0.9rem;
    vertical-align: 1px;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-figure {
      max-width: 26rem;
    }
  }
</style>
