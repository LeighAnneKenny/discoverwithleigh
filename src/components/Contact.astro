---
import Eyebrow from './Eyebrow.astro';
import { socials } from '../data/site';
import type { SiteContent } from '../lib/content';

const { contact } = Astro.props as { contact: SiteContent['contact'] };

// Sitekeys are public identifiers; the secret lives only as a Worker secret.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '0x4AAAAAADwIcHofRL-bGbeM';
---
<section class="section" id="contact">
  <div class="wrap contact-grid">
    <div class="reveal">
      <Eyebrow>Get in touch</Eyebrow>
      <h2 class="section-heading">Let’s make your vision a reality</h2>
      <dl class="contact-details">
        <dt>Call</dt>
        <dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
        <dt>Email</dt>
        <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        <dt>Studio</dt>
        <dd>{contact.studio}</dd>
      </dl>
      <a class="btn" href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp to set up a meeting</a>
      <ul class="contact-socials" aria-label="Social media">
        {socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>
        ))}
      </ul>
    </div>

    <form class="contact-form reveal" method="post" action="/api/contact" id="contact-form">
      <p class="form-status" id="form-status" role="status" hidden>
        Thank you — your message is on its way. I’ll get back to you soon!
      </p>
      <p class="form-status form-error" id="form-error" role="alert" hidden>
        Something went wrong sending your message. Please try again, or reach me on WhatsApp or email instead.
      </p>
      <div class="form-row">
        <label>First name<input name="firstName" required autocomplete="given-name" /></label>
        <label>Last name<input name="lastName" required autocomplete="family-name" /></label>
      </div>
      <label>Email address<input name="email" type="email" required autocomplete="email" /></label>
      <label>Contact number<input name="phone" type="tel" autocomplete="tel" /></label>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <input class="trap" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-action="turnstile-spin-v1"
        data-theme="dark"
      ></div>
      <button class="btn" type="submit">Send message</button>
    </form>
  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const params = new URLSearchParams(location.search);
  const banner = params.has('sent') ? 'form-status' : params.has('error') ? 'form-error' : null;
  if (banner) {
    document.getElementById(banner)!.hidden = false;
    document.getElementById('contact')!.scrollIntoView();
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .contact-details {
    margin-block: 0.5rem 2rem;
  }
  .contact-details dt {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    margin-top: 1.1rem;
  }
  .contact-details dd {
    font-size: 1.05rem;
  }
  .contact-details a {
    color: var(--paper);
  }
  .contact-details a:hover {
    color: var(--teal-hi);
  }
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    margin-top: 2.2rem;
  }
  .contact-socials a {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .contact-socials a:hover {
    color: var(--teal-hi);
  }

  .contact-form {
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 1.1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mist);
  }
  input,
  textarea {
    font: 1rem var(--font-body);
    color: var(--paper);
    background: var(--ink-2);
    border: 1px solid var(--line);
    padding: 0.8rem 1rem;
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--teal);
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .form-status {
    border: 1px solid var(--teal);
    color: var(--teal-hi);
    padding: 0.9rem 1.1rem;
    font-size: 0.95rem;
  }
  .form-error {
    border-color: #c4544d;
    color: #e08a84;
  }
  .contact-form .btn {
    justify-self: start;
    background: var(--teal);
    color: var(--ink);
    cursor: pointer;
  }
  .contact-form .btn:hover {
    background: var(--teal-hi);
    border-color: var(--teal-hi);
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
