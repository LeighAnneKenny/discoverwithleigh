---
import type { SiteContent } from '../lib/content';

// "Questions?" pill above the WhatsApp FAB (PRD item 13): question chips
// revealing admin-curated verbatim answers, ending at the same conversation
// CTAs as the rest of the site. Renders nothing when no items are shown.
const { qa, contact } = Astro.props as { qa: SiteContent['qa']; contact: SiteContent['contact'] };
const items = qa.filter((i) => i.show);
const waHref = `https://wa.me/${contact.phoneHref.replace(/\D/g, '')}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
{items.length > 0 && (
  <div class="qa" id="qa" data-min>
    <div class="qa-panel" id="qa-panel" hidden>
      <header class="qa-head">
        <p class="qa-title">Quick answers</p>
        <button class="qa-close" id="qa-close" aria-label="Close quick answers">&times;</button>
      </header>
      <div class="qa-list">
        {items.map((item) => (
          <details class="qa-item" name="qa-acc">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
      <footer class="qa-foot">
        <a class="qa-wa" href={waHref} target="_blank" rel="noopener">Something else? Ask me directly</a>
        <a class="qa-contact" href="#contact">or use the contact form</a>
      </footer>
    </div>
    <button class="qa-pill" id="qa-pill" aria-expanded="false" aria-controls="qa-panel" aria-label="Questions?">
      <span class="q-mini" aria-hidden="true">?</span><span class="q-full">Questions?</span>
    </button>
  </div>
)}

<script>
  const pill = document.getElementById('qa-pill');
  const panel = document.getElementById('qa-panel');
  if (pill && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      pill.setAttribute('aria-expanded', String(open));
    };
    pill.addEventListener('click', () => setOpen(panel.hidden));
    document.getElementById('qa-close')!.addEventListener('click', () => setOpen(false));
    panel.querySelector('.qa-contact')!.addEventListener('click', () => setOpen(false));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    // Starts minimised (a "?" circle, mobile only per the CSS); expands to the
    // labelled pill once the visitor reaches the reviews — the point where
    // questions about rates/booking actually form.
    const qa = document.getElementById('qa')!;
    const reviews = document.getElementById('reviews');
    if (reviews) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          qa.removeAttribute('data-min');
          io.disconnect();
        }
      });
      io.observe(reviews);
    } else {
      qa.removeAttribute('data-min');
    }
  }
</script>

<style>
  .qa {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    /* stack above the WhatsApp FAB (3.4rem tall at the same inset) */
    bottom: calc(clamp(1rem, 3vw, 1.75rem) + 3.4rem + 0.85rem);
    z-index: 40;
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }
  .qa-pill {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper);
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 1.05rem;
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    transition: color 0.2s, border-color 0.2s;
  }
  .qa-pill:hover,
  .qa-pill[aria-expanded='true'] {
    color: var(--teal-hi);
    border-color: var(--teal);
  }
  /* the "?" is only ever shown in the minimised mobile state */
  .q-mini {
    display: none;
  }
  /* minimised form (mobile only): a quiet "?" circle matching the FAB column
     until the visitor reaches the reviews — then it unfurls into the label.
     width:auto can't transition, so both spans crossfade via max-width. */
  @media (max-width: 760px) {
    .qa .qa-pill {
      height: 2.7rem;
      min-width: 2.7rem; /* keeps the minimised state circular without a fixed width (which couldn't transition to auto) */
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .qa .qa-pill .q-mini,
    .qa .qa-pill .q-full {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      transition: max-width 0.35s ease, opacity 0.3s ease;
    }
    .qa .qa-pill .q-mini {
      font-size: 1rem;
      letter-spacing: 0;
      color: var(--teal-hi);
      max-width: 0;
      opacity: 0;
    }
    .qa .qa-pill .q-full {
      max-width: 12rem;
      opacity: 1;
      padding-inline: 1.05rem;
    }
    .qa[data-min] .qa-pill .q-mini {
      max-width: 1.2rem;
      opacity: 1;
    }
    .qa[data-min] .qa-pill .q-full {
      max-width: 0;
      opacity: 0;
      padding-inline: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .qa .qa-pill .q-mini,
    .qa .qa-pill .q-full {
      transition: none;
    }
  }
  .qa-panel[hidden] {
    display: none; /* author display:flex would otherwise defeat the hidden attribute */
  }
  .qa-panel {
    width: min(22.5rem, calc(100vw - 2 * clamp(1rem, 3vw, 1.75rem)));
    max-height: min(65svh, 30rem);
    display: flex;
    flex-direction: column;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }
  .qa-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.1rem 0.6rem;
  }
  .qa-title {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .qa-close {
    background: none;
    border: 0;
    color: var(--mist);
    font-size: 1.3rem;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    cursor: pointer;
  }
  .qa-close:hover {
    color: var(--teal-hi);
  }
  .qa-list {
    overflow-y: auto;
    padding: 0 1.1rem;
  }
  .qa-item {
    border-top: 1px solid var(--line);
  }
  .qa-item summary {
    -webkit-tap-highlight-color: transparent;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    transition: color 0.2s;
  }
  .qa-item summary::-webkit-details-marker {
    display: none;
  }
  .qa-item summary::after {
    content: '+';
    color: var(--teal);
    font-size: 1rem;
    flex-shrink: 0;
  }
  .qa-item[open] summary,
  .qa-item summary:hover {
    color: var(--teal-hi);
  }
  .qa-item[open] summary::after {
    content: '−';
  }
  .qa-item p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--mist);
    padding-bottom: 0.9rem;
  }
  .qa-foot {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 1.1rem 1rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .qa-wa {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-hi);
  }
  .qa-wa:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .qa-contact {
    font-size: 0.78rem;
    color: var(--mist);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .qa-contact:hover {
    color: var(--teal-hi);
  }
</style>
